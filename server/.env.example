# Copy this file to .env and fill in values. Never commit .env.

# PostgreSQL — matches docker-compose defaults for local dev
DATABASE_URL=postgres://adpack:adpack@localhost:5432/adpack

# Redis — matches docker-compose defaults for local dev
REDIS_URL=redis://localhost:6379

# HTTP server port
PORT=8080

# Static file paths (relative to where the binary runs, i.e. the server/ directory)
CLIENT_DIR=../client   # HTML/CSS/JS kiosk player
ASSETS_DIR=./assets    # uploaded ad creatives (images, videos)

# Stripe — get from dashboard.stripe.com (use test keys for dev)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# AWS S3 (or Cloudflare R2) for ad asset storage
S3_BUCKET=adpack-assets
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=...

# API key for management endpoints (venues, advertisers, slots, bookings)
# generate with: openssl rand -hex 24
API_KEY=...
