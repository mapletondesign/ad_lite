# Copy this file to .env and fill in values. Never commit .env.

# PostgreSQL — matches docker-compose defaults for local dev
DATABASE_URL=postgres://adlite:adlite@localhost:5432/adlite

# Redis — matches docker-compose defaults for local dev
REDIS_URL=redis://localhost:6379

# HTTP server port
PORT=8080

# Static file paths (relative to where the binary runs, i.e. the server/ directory)
CLIENT_DIR=../client   # HTML/CSS/JS kiosk player

# Stripe — get from dashboard.stripe.com (use test keys for dev)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudflare R2 (S3-compatible) for ad creative storage
# S3_ENDPOINT: https://<account_id>.r2.cloudflarestorage.com
# CDN_BASE_URL: public URL prefix for serving assets (e.g. https://assets.adlite.com)
# If these are unset the upload endpoint is disabled at startup.
S3_BUCKET=adlite-assets
S3_REGION=auto
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
CDN_BASE_URL=https://assets.adlite.com
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

# RSA keypair for JWT signing (RS256).
# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   JWT_PRIVATE_KEY_B64=$(base64 -i private.pem)
#   JWT_PUBLIC_KEY_B64=$(base64 -i public.pem)
JWT_PRIVATE_KEY_B64=...
JWT_PUBLIC_KEY_B64=...
